# Public showcase repository: track only these reviewed files.
/*
!/.gitignore
!/_config.yml
!/README.md
!/index.html
!/go.html
!/Inter.woff2
!/LICENSE-Inter.txt
!/INSTALL.md
!/ARCHIVE_OLD_DEV_LOGS.md
!/CHEST_AFFINITIES.md
!/AGENTS.md
!/Icon.png
!/Shima QoL-banner.png
!/THIRD_PARTY_NOTICES.md
!/LICENSE-imgui.txt
!/LICENSE-cimgui.txt

# Reviewed gameplay media only. Keep source files and other media excluded.
!/media/
/media/*
!/media/tooltip-overlay.gif
!/media/quick-actions.gif
!/media/automation-chest.gif
!/media/storage-movement.gif
!/media/plot-planner.gif
!/media/player-wedding.gif
